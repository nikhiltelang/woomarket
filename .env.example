# Leave DATABASE_URL unset on a fresh copy to use the web installer instead: start the app and
# open it in a browser (the console prints the address and a setup code). It writes this file for you.
# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# APP_NAME=WooMarket360
# SHUTDOWN_TIMEOUT_MS=8000

# --- Database (MySQL 8.0.13+) ------------------------------------------------
# URL-encode special characters in the password (% -> %25, @ -> %40, # -> %23).
DATABASE_URL="mysql://woomarket360:change-this-password@127.0.0.1:3306/woomarket360"
# DB_POOL_MAX=25
# DB_CONNECT_RETRIES=10

# --- Security ----------------------------------------------------------------
# Required in production: openssl rand -hex 32
SESSION_SECRET=
# Optional; falls back to SESSION_SECRET
# JWT_SECRET=
# Encrypts WhatsApp access tokens at rest (recommended): openssl rand -hex 32
ENCRYPTION_KEY=
# Superadmin password used by the seed in production (random and printed once if unset)
# SEED_SUPERADMIN_PASSWORD=
# Set to "false" to disable Secure cookies even behind HTTPS
# FORCE_HTTPS=

# --- WhatsApp Cloud API ------------------------------------------------------
WHATSAPP_API_VERSION=v25.0
# Verify token you enter in the Meta app's webhook settings
WEBHOOK_VERIFY_TOKEN=
# Meta app secret; verifies X-Hub-Signature-256 on webhooks (required in production).
# Can also be set in System settings → WhatsApp Embedded Signup.
WHATSAPP_APP_SECRET=
# Route every channel through the local simulator (no Meta calls)
# WHATSAPP_SIMULATE=false

# --- Email (platform fallback when neither the tenant nor the superadmin saved SMTP settings) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@example.com
# SMTP_PASS=change-me
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=WooMarket360
# Capture emails instead of sending: true | false (default: on outside production when no SMTP is set)
# EMAIL_SIMULATE=
# Route every SMS through the simulator
# SMS_SIMULATE=false

# --- Message queue -------------------------------------------------------------
# MESSAGE_QUEUE_INTERVAL_MS=5000
# MESSAGE_QUEUE_BATCH_SIZE=50
# MESSAGE_QUEUE_CONCURRENCY=5
# MESSAGE_SEND_DELAY_MS=100
# MESSAGE_QUEUE_MAX_ATTEMPTS=3

# --- Scaling (optional; usually set in Superadmin → System settings → Queue & scaling) ---
# Redis for several app servers sharing the work. Without it one server (NODE_APP_INSTANCE=0) runs the workers.
# REDIS_URL=redis://:password@127.0.0.1:6379/0
# WhatsApp messages per second per number, across all servers (Redis mode)
# MESSAGE_RATE_PER_SECOND=40

# --- AI assistant (optional; the key can also be saved in Superadmin → AI assistant) ---
# ANTHROPIC_API_KEY=

# --- Development helpers ---
# Let outgoing webhooks reach localhost / private addresses (local testing only)
# WEBHOOK_ALLOW_PRIVATE_URLS=true
# Extra host names the Vite dev server accepts (testing white-label domains locally)
# DEV_ALLOWED_HOSTS=app.agency.test,.localtest.me

# --- Rate limits (requests per minute) -----------------------------------------
# API_RATE_LIMIT_AUTHED=1200
# API_RATE_LIMIT_UNAUTHED=300
# AUTH_RATE_LIMIT=20

# --- Advanced ---------------------------------------------------------------------
# APP_UPDATE_ROOT=/var/www/woomarket360
# LOG_LEVEL=info
