PORT=5000
# Required in production: a long random string used to sign session cookies.
SESSION_SECRET=change-me
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Demo accounts (override in production).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: override the project root the updater manages (defaults to cwd).
# APP_UPDATE_ROOT=/var/www/woomarket360
